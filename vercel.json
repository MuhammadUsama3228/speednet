{
  "headers": [
    {
      "source": "/api/librespeed/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,POST"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "http://scanpings.net/:path*",
      "destination": "https://scanpings.net/:path*",
      "permanent": true
    }
  ]
}